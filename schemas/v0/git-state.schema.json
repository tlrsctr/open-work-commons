{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openworkcommons.org/schemas/v0/git-state.schema.json",
  "title": "Open Work Commons v0 Git state",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "repository_id",
    "object_format",
    "captured_at",
    "base_commit",
    "head_commit",
    "head_tree",
    "head_ref",
    "worktree"
  ],
  "properties": {
    "schema_version": { "const": "0.1" },
    "repository_id": { "type": "string", "minLength": 1, "maxLength": 512 },
    "object_format": { "enum": ["sha1", "sha256"] },
    "captured_at": { "type": "string", "format": "date-time" },
    "base_commit": { "$ref": "#/$defs/gitOid" },
    "head_commit": { "$ref": "#/$defs/gitOid" },
    "head_tree": { "$ref": "#/$defs/gitOid" },
    "head_ref": { "type": ["string", "null"], "maxLength": 1024 },
    "worktree": {
      "type": "object",
      "additionalProperties": false,
      "required": ["clean", "untracked"],
      "properties": {
        "clean": { "type": "boolean" },
        "patch": {
          "$ref": "#/$defs/archiveArtifactReference"
        },
        "untracked": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "included", "digest", "byte_length"],
            "properties": {
              "path": { "$ref": "#/$defs/relativePath" },
              "included": { "type": "boolean" },
              "digest": { "$ref": "#/$defs/digest" },
              "byte_length": { "type": "integer", "minimum": 0 },
              "artifact": {
                "$ref": "#/$defs/archiveArtifactReference"
              }
            },
            "allOf": [
              {
                "if": {
                  "properties": { "included": { "const": true } },
                  "required": ["included"]
                },
                "then": { "required": ["artifact"] },
                "else": { "not": { "required": ["artifact"] } }
              }
            ]
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "clean": { "const": true } },
            "required": ["clean"]
          },
          "then": {
            "properties": {
              "untracked": { "type": "array", "maxItems": 0 }
            },
            "not": { "required": ["patch"] }
          },
          "else": {
            "anyOf": [
              { "required": ["patch"] },
              {
                "properties": {
                  "untracked": { "type": "array", "minItems": 1 }
                }
              }
            ]
          }
        }
      ]
    },
    "extensions": { "$ref": "#/$defs/extensions" }
  },
  "allOf": [
    {
      "if": { "properties": { "object_format": { "const": "sha1" } } },
      "then": {
        "properties": {
          "base_commit": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
          "head_commit": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
          "head_tree": { "type": "string", "pattern": "^[a-f0-9]{40}$" }
        }
      }
    },
    {
      "if": { "properties": { "object_format": { "const": "sha256" } } },
      "then": {
        "properties": {
          "base_commit": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "head_commit": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "head_tree": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        }
      }
    }
  ],
  "$defs": {
    "gitOid": {
      "type": "string",
      "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$"
    },
    "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "archiveArtifactReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "digest", "byte_length"],
      "properties": {
        "path": { "$ref": "#/$defs/relativePath" },
        "digest": { "$ref": "#/$defs/digest" },
        "byte_length": { "type": "integer", "minimum": 0 }
      }
    },
    "relativePath": {
      "type": "string",
      "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)(?:\\.|\\.\\.)(?:/|$))(?!.*//)[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*$",
      "maxLength": 1024
    },
    "extensions": {
      "type": "object",
      "propertyNames": { "pattern": "^[a-z0-9][a-z0-9.-]*/[A-Za-z0-9._-]+$" },
      "additionalProperties": true
    }
  }
}
