{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openworkcommons.org/schemas/v0/evidence.schema.json",
  "title": "Open Work Commons v0 evidence object",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "evidence_id",
    "kind",
    "issuer",
    "subject_digest",
    "result",
    "observed_at"
  ],
  "properties": {
    "schema_version": { "const": "0.1" },
    "evidence_id": { "type": "string", "minLength": 1, "maxLength": 512 },
    "kind": { "type": "string", "minLength": 1, "maxLength": 128 },
    "issuer": { "type": "string", "minLength": 1, "maxLength": 512 },
    "subject_digest": { "$ref": "#/$defs/digest" },
    "result": { "enum": ["passed", "failed", "unknown"] },
    "observed_at": { "type": "string", "format": "date-time" },
    "extensions": { "$ref": "#/$defs/extensions" }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "extensions": {
      "type": "object",
      "propertyNames": { "pattern": "^[a-z0-9][a-z0-9.-]*/[A-Za-z0-9._-]+$" },
      "additionalProperties": true
    }
  }
}
